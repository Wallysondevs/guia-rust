<p class="intro">Na <a href="projeto-cli.html">parte 1</a>, o <strong>resumo</strong> ficou funcionando, mas todo num arquivo só e sem testes. Agora vamos deixá-lo com cara de projeto profissional: lógica numa biblioteca testável, testes de três tipos, leitura da entrada padrão (para usar com <code>|</code>), uma opção por variável de ambiente e o binário otimizado.</p>

<hr>
<h2>Passo 4: separar biblioteca e binário</h2>
<p>Um pacote pode ter ao mesmo tempo <code>src/lib.rs</code> (uma biblioteca) e <code>src/main.rs</code> (o programa). O <code>main.rs</code> fica pequeno: lê os argumentos, chama a biblioteca e trata erros. Tudo que tem lógica vai para o <code>lib.rs</code>, onde é fácil de testar.</p>
<pre class="file" data-file="src/lib.rs">//! Resumo de textos: conta linhas, palavras e as palavras mais frequentes.
use std::collections::HashMap;
use std::error::Error;
use std::{env, fs, io};

pub struct Config {
    pub arquivo: String,
    pub top: usize,
    pub minimo: usize,
}

impl Config {
    pub fn new(args: &amp;[String]) -&gt; Result&lt;Config, String&gt; {
        if args.len() &lt; 2 {
            return Err("faltou o nome do arquivo".to_string());
        }
        let arquivo = args[1].clone();
        let top = match args.get(2) {
            Some(t) =&gt; t.parse().map_err(|_| format!("'{t}' não é um número"))?,
            None =&gt; 5,
        };
        let minimo = match env::var("RESUMO_MIN") {
            Ok(v) =&gt; v.parse().map_err(|_| format!("RESUMO_MIN inválido: '{v}'"))?,
            Err(_) =&gt; 1,
        };
        Ok(Config { arquivo, top, minimo })
    }
}

/// Separa o texto em palavras minúsculas, sem pontuação nas pontas.
///
/// ```
/// let p = resumo::palavras("Olá, mundo! Olá.");
/// assert_eq!(p, vec!["olá", "mundo", "olá"]);
/// ```
pub fn palavras(texto: &amp;str) -&gt; Vec&lt;String&gt; {
    texto
        .split_whitespace()
        .map(|p| p.trim_matches(|c: char| !c.is_alphanumeric()).to_lowercase())
        .filter(|p| !p.is_empty())
        .collect()
}

/// Conta as palavras com pelo menos `minimo` letras e ordena:
/// mais frequentes primeiro; no empate, em ordem alfabética.
pub fn ranking(palavras: &amp;[String], minimo: usize) -&gt; Vec&lt;(String, usize)&gt; {
    let mut contagem: HashMap&lt;&amp;str, usize&gt; = HashMap::new();
    for p in palavras.iter().filter(|p| p.chars().count() &gt;= minimo) {
        *contagem.entry(p.as_str()).or_insert(0) += 1;
    }
    let mut r: Vec&lt;(String, usize)&gt; = contagem
        .into_iter()
        .map(|(p, n)| (p.to_string(), n))
        .collect();
    r.sort_by(|a, b| b.1.cmp(&amp;a.1).then(a.0.cmp(&amp;b.0)));
    r
}

pub fn executar(config: Config) -&gt; Result&lt;(), Box&lt;dyn Error&gt;&gt; {
    let texto = if config.arquivo == "-" {
        io::read_to_string(io::stdin())?
    } else {
        fs::read_to_string(&amp;config.arquivo)
            .map_err(|e| format!("não consegui ler {}: {e}", config.arquivo))?
    };
    let ps = palavras(&amp;texto);
    println!("linhas: {}", texto.lines().count());
    println!("palavras: {}", ps.len());
    println!("caracteres: {}", texto.chars().count());
    println!("mais frequentes:");
    for (p, n) in ranking(&amp;ps, config.minimo).iter().take(config.top) {
        println!("{n:&gt;4}  {p}");
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    fn s(v: &amp;[&amp;str]) -&gt; Vec&lt;String&gt; {
        v.iter().map(|x| x.to_string()).collect()
    }

    #[test]
    fn tira_pontuacao_e_maiusculas() {
        assert_eq!(palavras("O rio, o MAR."), s(&amp;["o", "rio", "o", "mar"]));
    }

    #[test]
    fn ranking_ordena_por_frequencia_e_nome() {
        let r = ranking(&amp;s(&amp;["b", "a", "b", "c", "a", "b"]), 1);
        assert_eq!(r[0], ("b".to_string(), 3));
        assert_eq!(r[1], ("a".to_string(), 2));
        assert_eq!(r[2], ("c".to_string(), 1));
    }

    #[test]
    fn ranking_respeita_minimo() {
        let r = ranking(&amp;s(&amp;["o", "rio", "o"]), 2);
        assert_eq!(r, vec![("rio".to_string(), 1)]);
    }

    #[test]
    fn config_sem_arquivo_da_erro() {
        assert!(Config::new(&amp;s(&amp;["resumo"])).is_err());
    }

    #[test]
    fn config_top_invalido() {
        match Config::new(&amp;s(&amp;["resumo", "a.txt", "dez"])) {
            Err(e) =&gt; assert!(e.contains("não é um número")),
            Ok(_) =&gt; panic!("deveria dar erro"),
        }
    }
}</pre>
<pre class="file" data-file="src/main.rs">use std::{env, process};

use resumo::Config;

fn main() {
    let args: Vec&lt;String&gt; = env::args().collect();
    let config = Config::new(&amp;args).unwrap_or_else(|erro| {
        eprintln!("erro: {erro}");
        eprintln!("uso: resumo &lt;arquivo|-&gt; [quantas palavras]");
        process::exit(1);
    });
    if let Err(e) = resumo::executar(config) {
        eprintln!("erro: {e}");
        process::exit(1);
    }
}</pre>
<dl class="anatomy"><dt>//! ...</dt><dd>documentação do crate inteiro.</dd><dt>pub</dt><dd>só o que é <code>pub</code> pode ser usado pelo <code>main.rs</code>, que enxerga a biblioteca como um crate de fora, pelo nome <code>resumo</code>.</dd><dt>env::var("RESUMO_MIN")</dt><dd>lê uma variável de ambiente; se ela não existir, o tamanho mínimo de palavra é 1.</dd><dt>arquivo == "-"</dt><dd>convenção de terminal: <code>-</code> quer dizer “leia da entrada padrão”.</dd><dt>io::read_to_string(io::stdin())</dt><dd>lê toda a entrada padrão para uma <code>String</code>.</dd></dl>

<hr>
<h2>Passo 5: os testes</h2>
<p>Os testes de unidade ficam no fim do <code>lib.rs</code> (já estão no arquivo acima, no módulo <code>tests</code>). O comentário <code>///</code> de <code>palavras</code> tem um exemplo de código: o <code>cargo test</code> também o compila e roda, é o <em>doc-test</em>. Por fim, um teste de integração em <code>tests/</code> roda o <strong>binário</strong> de verdade:</p>
<pre class="file" data-file="tests/cli.rs">use std::process::Command;

#[test]
fn resume_o_poema() {
    let saida = Command::new(env!("CARGO_BIN_EXE_resumo"))
        .args(["poema.txt", "1"])
        .output()
        .unwrap();
    assert!(saida.status.success());
    let texto = String::from_utf8(saida.stdout).unwrap();
    assert!(texto.contains("linhas: 9"));
    assert!(texto.contains("   8  o"));
}

#[test]
fn arquivo_inexistente_sai_com_erro() {
    let saida = Command::new(env!("CARGO_BIN_EXE_resumo"))
        .arg("nao-existe.txt")
        .output()
        .unwrap();
    assert_eq!(saida.status.code(), Some(1));
    let erro = String::from_utf8(saida.stderr).unwrap();
    assert!(erro.contains("não consegui ler"));
}</pre>
<p><code>env!("CARGO_BIN_EXE_resumo")</code> é o caminho do executável que o cargo compilou para os testes. <code>Command</code> roda o programa como se fosse no terminal e captura saída e código de saída.</p>
::: terminal resumo projeto
$ cargo test -q
--- oculto src/lib.rs
//! Resumo de textos: conta linhas, palavras e as palavras mais frequentes.
use std::collections::HashMap;
use std::error::Error;
use std::{env, fs, io};

pub struct Config {
    pub arquivo: String,
    pub top: usize,
    pub minimo: usize,
}

impl Config {
    pub fn new(args: &[String]) -> Result<Config, String> {
        if args.len() < 2 {
            return Err("faltou o nome do arquivo".to_string());
        }
        let arquivo = args[1].clone();
        let top = match args.get(2) {
            Some(t) => t.parse().map_err(|_| format!("'{t}' não é um número"))?,
            None => 5,
        };
        let minimo = match env::var("RESUMO_MIN") {
            Ok(v) => v.parse().map_err(|_| format!("RESUMO_MIN inválido: '{v}'"))?,
            Err(_) => 1,
        };
        Ok(Config { arquivo, top, minimo })
    }
}

/// Separa o texto em palavras minúsculas, sem pontuação nas pontas.
///
/// ```
/// let p = resumo::palavras("Olá, mundo! Olá.");
/// assert_eq!(p, vec!["olá", "mundo", "olá"]);
/// ```
pub fn palavras(texto: &str) -> Vec<String> {
    texto
        .split_whitespace()
        .map(|p| p.trim_matches(|c: char| !c.is_alphanumeric()).to_lowercase())
        .filter(|p| !p.is_empty())
        .collect()
}

/// Conta as palavras com pelo menos `minimo` letras e ordena:
/// mais frequentes primeiro; no empate, em ordem alfabética.
pub fn ranking(palavras: &[String], minimo: usize) -> Vec<(String, usize)> {
    let mut contagem: HashMap<&str, usize> = HashMap::new();
    for p in palavras.iter().filter(|p| p.chars().count() >= minimo) {
        *contagem.entry(p.as_str()).or_insert(0) += 1;
    }
    let mut r: Vec<(String, usize)> = contagem
        .into_iter()
        .map(|(p, n)| (p.to_string(), n))
        .collect();
    r.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
    r
}

pub fn executar(config: Config) -> Result<(), Box<dyn Error>> {
    let texto = if config.arquivo == "-" {
        io::read_to_string(io::stdin())?
    } else {
        fs::read_to_string(&config.arquivo)
            .map_err(|e| format!("não consegui ler {}: {e}", config.arquivo))?
    };
    let ps = palavras(&texto);
    println!("linhas: {}", texto.lines().count());
    println!("palavras: {}", ps.len());
    println!("caracteres: {}", texto.chars().count());
    println!("mais frequentes:");
    for (p, n) in ranking(&ps, config.minimo).iter().take(config.top) {
        println!("{n:>4}  {p}");
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    fn s(v: &[&str]) -> Vec<String> {
        v.iter().map(|x| x.to_string()).collect()
    }

    #[test]
    fn tira_pontuacao_e_maiusculas() {
        assert_eq!(palavras("O rio, o MAR."), s(&["o", "rio", "o", "mar"]));
    }

    #[test]
    fn ranking_ordena_por_frequencia_e_nome() {
        let r = ranking(&s(&["b", "a", "b", "c", "a", "b"]), 1);
        assert_eq!(r[0], ("b".to_string(), 3));
        assert_eq!(r[1], ("a".to_string(), 2));
        assert_eq!(r[2], ("c".to_string(), 1));
    }

    #[test]
    fn ranking_respeita_minimo() {
